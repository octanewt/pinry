# Pinry settings. Copy to .env and edit; every value is read from the
# environment. Values are case-insensitive for true/false flags.

# Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Required in production: the host names and addresses Pinry is reached
# at, comma separated. Pinry refuses to start without it.
ALLOWED_HOSTS=pins.example.com,192.168.1.10

# Origins (with scheme) for login behind a proxy that changes the host or
# scheme, e.g. https://pins.example.com. Usually not needed.
#CSRF_TRUSTED_ORIGINS=

# Database. SQLite in /data by default in Docker. For Postgres (14+):
#DATABASE_URL=postgres://pinry:password@db:5432/pinry
# docker-compose.postgres.example.yml builds DATABASE_URL from this instead:
#POSTGRES_PASSWORD=

# Set to true when a TLS proxy serves Pinry over HTTPS (secure cookies).
#HTTPS=false
# HSTS lifetime in seconds; set only once HTTPS works.
#HSTS_SECONDS=0

# Let anonymous visitors see public pins and boards.
#PUBLIC=true
# Let people create their own accounts.
#ALLOW_NEW_REGISTRATIONS=true

# Accept HTTP Basic auth on the API (tokens are preferred).
#ALLOW_BASIC_AUTH=false
# Failed password checks allowed per client address, or "off".
#LOGIN_THROTTLE_RATE=20/hour

# Let users pin images from LAN or other private addresses. Only enable it
# if you trust every account holder.
#ALLOW_PRIVATE_URL_FETCH=false
# Largest image downloaded when pinning by URL, in bytes.
#MAX_FETCH_BYTES=52428800

# Delete image files when their last pin is removed.
#IMAGE_AUTO_DELETE=true
# Thumbnail sizes, as JSON.
#IMAGE_SIZES={"thumbnail": {"size": [240, 0]}, "standard": {"size": [600, 0]}, "square": {"crop": true, "size": [125, 125]}}

# Plugin classes to load, comma separated.
#ENABLED_PLUGINS=
