# -----------------------------------------------------------------------------
# docker-pinry
#
# Builds the release image: nginx, gunicorn and the built SPA in a single
# container. Configure it with environment variables (see .env.example) and
# keep /data on a volume.
#
# Platforms: linux/amd64 and linux/arm64.
# -----------------------------------------------------------------------------

# Build the SPA. Its output is plain files, so build it on the build host's
# platform even when the image is for another one.
FROM --platform=$BUILDPLATFORM node:26-trixie-slim AS spa-build

WORKDIR /pinry-spa
COPY pinry-spa/package.json pinry-spa/pnpm-lock.yaml pinry-spa/pnpm-workspace.yaml ./
RUN npm install -g pnpm@12
RUN pnpm install --frozen-lockfile
COPY pinry-spa .
RUN pnpm build


# Install the Python dependencies from uv.lock into /opt/venv.
FROM python:3.13-slim-trixie AS python-build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

RUN pip install --no-cache-dir uv
WORKDIR /pinry
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project


# Final image
FROM python:3.13-slim-trixie
ARG DEBIAN_FRONTEND=noninteractive

# Run as uid/gid 1000, which usually owns the host's data directory.
RUN groupmod -g 1000 www-data \
 && usermod -u 1000 -g 1000 www-data \
 && mkdir /data \
 && chown www-data:www-data /data

# Pillow and psycopg wheels bundle their own libraries; only nginx is needed.
RUN apt-get update \
 && apt-get -y install --no-install-recommends nginx \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/nginx/sites-enabled/default

COPY --from=python-build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=pinry.settings.docker

WORKDIR /pinry
COPY . .
COPY --from=spa-build /pinry-spa/dist /pinry/pinry-spa/dist

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/sites-enabled/default /etc/nginx/sites-enabled/default

# 80 is for nginx; /data holds the database, static files and media.
EXPOSE 80
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "/pinry/docker/scripts/healthcheck.py"]
CMD ["/pinry/docker/scripts/start.sh"]
